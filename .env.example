# Copy to .env and fill in. Anything prefixed with EXPO_PUBLIC_ is bundled
# into the app — never put true secrets here. Move secrets to a backend
# (Firebase Functions, in this project's case).

# --- Firebase (auth + firestore + functions) ---
# All values come from Firebase Console → Project Settings → "Your apps" → SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_REGION=us-central1

# --- Anthropic (DEV ONLY) ---
# In production the app calls a Firebase Function that holds the key
# server-side. Setting this in dev is fine and lets you skip Functions
# while iterating locally.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-haiku-4-5

# --- RevenueCat (subscriptions) — only with a custom dev build ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
