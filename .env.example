# Copy to .env and fill in. Anything prefixed with EXPO_PUBLIC_ is bundled into
# the app — never put true secrets here. Move secrets to a backend proxy.

# --- Supabase (auth) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (AI chat) — prototyping only; move to a backend before launch ---
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-haiku-4-5

# --- RevenueCat (subscriptions) — only with a custom dev build ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
